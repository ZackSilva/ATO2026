# For local Docker settings, run: python3 scripts/setup_local.py
# These blank values are examples, not working credentials.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DATABASE_URL=postgresql+psycopg://slabtrak_app:REPLACE@db:5432/slabtrak
MIGRATION_DATABASE_URL=postgresql+psycopg://slabtrak_admin:REPLACE@db:5432/slabtrak
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Local Docker uses its private named volume. Hosted photos use supabase instead.
PHOTO_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=card-photos
# Optional: automatic completed-auction search. Never commit a real key.
CARDSIGHT_API_KEY=
# Optional: operator PSA Public API token for certificate-based card details.
PSA_API_TOKEN=
